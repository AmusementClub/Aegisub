<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <NoWarn>$(NoWarn);NU5100</NoWarn>
    <Version>0.1.0</Version>
    <AssemblyName>Aegisub.Plugin.BuildTasks</AssemblyName>
    <RootNamespace>Aegisub.Plugin.BuildTasks</RootNamespace>
    <PackageId>Aegisub.Plugin.BuildTasks</PackageId>
    <Authors>Aegisub</Authors>
    <Description>MSBuild tasks and targets for Aegisub plugin manifests and package validation.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>aegisub;plugin;msbuild;nuget;nativeaot</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework"
               HintPath="$(MSBuildBinPath)\Microsoft.Build.Framework.dll"
               Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core"
               HintPath="$(MSBuildBinPath)\Microsoft.Build.Utilities.Core.dll"
               Private="false" />
    <None Include="buildTransitive\Aegisub.Plugin.BuildTasks.targets"
          Pack="true"
          PackagePath="buildTransitive\Aegisub.Plugin.BuildTasks.targets" />
    <None Include="$(OutputPath)$(AssemblyName).dll"
          Pack="true"
          PackagePath="tasks\net10.0\$(AssemblyName).dll"
          Visible="false" />
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
