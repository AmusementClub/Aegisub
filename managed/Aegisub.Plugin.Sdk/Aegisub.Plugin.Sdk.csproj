<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.1.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <AssemblyName>Aegisub.Plugin.Sdk</AssemblyName>
    <RootNamespace>Aegisub.Plugin.Sdk</RootNamespace>
    <PackageId>Aegisub.Plugin.Sdk</PackageId>
    <Authors>Aegisub</Authors>
    <Description>Attributes and build-time descriptors for Aegisub managed plugins.</Description>
    <PackageLicenseExpression>BSD-3-Clause</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>aegisub;plugin;sdk;nativeaot;automation</PackageTags>
    <NuspecFile>Aegisub.Plugin.Sdk.nuspec</NuspecFile>
    <NuspecBasePath>$(MSBuildProjectDirectory)</NuspecBasePath>
    <NuspecProperties>configuration=$(Configuration)</NuspecProperties>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Aegisub.Managed.Contracts\Aegisub.Managed.Contracts.csproj"
                      Private="false"
                      TreatAsPackageReference="true" />
    <ProjectReference Include="..\Aegisub.Plugin.Generators\Aegisub.Plugin.Generators.csproj"
                      ReferenceOutputAssembly="false"
                      TreatAsPackageReference="true" />
    <ProjectReference Include="..\Aegisub.Plugin.BuildTasks\Aegisub.Plugin.BuildTasks.csproj"
                      ReferenceOutputAssembly="false"
                      TreatAsPackageReference="true" />
    <None Include="PACKAGE_README.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>
</Project>
