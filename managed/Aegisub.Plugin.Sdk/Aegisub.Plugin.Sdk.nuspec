<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>Aegisub.Plugin.Sdk</id>
    <version>0.1.0</version>
    <authors>Aegisub</authors>
    <description>Attributes, generator, and build tasks for Aegisub managed plugins.</description>
    <license type="expression">BSD-3-Clause</license>
    <readme>README.md</readme>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <tags>aegisub plugin sdk nativeaot automation</tags>
    <dependencies>
      <group targetFramework="net10.0">
        <dependency id="Aegisub.Managed.Contracts" version="[0.1.0]" />
        <dependency id="Aegisub.Plugin.Generators" version="[0.1.0]" />
        <dependency id="Aegisub.Plugin.BuildTasks" version="[0.1.0]" />
      </group>
    </dependencies>
  </metadata>
  <files>
    <file src="bin\$configuration$\net10.0\Aegisub.Plugin.Sdk.dll"
          target="lib\net10.0\Aegisub.Plugin.Sdk.dll" />
    <file src="PACKAGE_README.md" target="README.md" />
  </files>
</package>
