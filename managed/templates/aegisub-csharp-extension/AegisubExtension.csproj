<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAotCompatible>true</IsAotCompatible>
    <Version>0.1.0</Version>
    <AssemblyName>AegisubExtension</AssemblyName>
    <RootNamespace>AegisubExtension</RootNamespace>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>

    <AegisubAutomationId>sample.extension</AegisubAutomationId>
    <AegisubContractsVersion>0.1.0</AegisubContractsVersion>
    <AegisubContractsProject Condition="'$(AegisubContractsProject)' == ''">__AEGISUB_CONTRACTS_PROJECT__</AegisubContractsProject>
    <AegisubDevelopmentRoot Condition="'$(AegisubDevelopmentRoot)' == ''">__AEGISUB_DEVELOPMENT_ROOT__</AegisubDevelopmentRoot>
    <AegisubDeployDevelopmentBuild Condition="'$(AegisubDeployDevelopmentBuild)' == '' and '$(Configuration)' == 'Debug'">true</AegisubDeployDevelopmentBuild>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(AegisubContractsProject)')">
    <ProjectReference Include="$(AegisubContractsProject)" Private="false" />
  </ItemGroup>

  <ItemGroup Condition="!Exists('$(AegisubContractsProject)')">
    <PackageReference Include="Aegisub.Managed.Contracts"
                      Version="[$(AegisubContractsVersion)]"
                      ExcludeAssets="runtime"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.aegisub-plugin.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="DeployAegisubDevelopmentExtension"
          AfterTargets="Build"
          Condition="'$(AegisubDeployDevelopmentBuild)' == 'true' and Exists('$(AegisubDevelopmentRoot)/Aegisub.exe')">
    <PropertyGroup>
      <_AegisubAutoloadDir>$(AegisubDevelopmentRoot)/automation/autoload</_AegisubAutoloadDir>
      <_AegisubPackageDir>$(_AegisubAutoloadDir)/$(AegisubAutomationId)</_AegisubPackageDir>
    </PropertyGroup>
    <ItemGroup>
      <_AegisubDevelopmentFile Include="$(TargetPath)"
                               DestinationSubPath="$(TargetFileName)" />
      <_AegisubDevelopmentFile Include="$(TargetDir)$(AssemblyName).pdb"
                               DestinationSubPath="$(AssemblyName).pdb"
                               Condition="Exists('$(TargetDir)$(AssemblyName).pdb')" />
      <_AegisubDevelopmentFile Include="$(TargetDir)$(AssemblyName).deps.json"
                               DestinationSubPath="$(AssemblyName).deps.json"
                               Condition="Exists('$(TargetDir)$(AssemblyName).deps.json')" />
      <_AegisubDevelopmentFile Include="@(ReferenceCopyLocalPaths)"
                               DestinationSubPath="%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)"
                               Exclude="$(TargetDir)Aegisub.Managed.Contracts.dll;$(TargetDir)Aegisub.Managed.Contracts.pdb" />
    </ItemGroup>
    <MakeDir Directories="$(_AegisubAutoloadDir);$(_AegisubPackageDir)" />
    <Copy SourceFiles="@(_AegisubDevelopmentFile)"
          DestinationFiles="@(_AegisubDevelopmentFile->'$(_AegisubPackageDir)/%(DestinationSubPath)')"
          SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)/extension.aegisub-plugin.json"
          DestinationFiles="$(_AegisubAutoloadDir)/$(AegisubAutomationId).aegisub-plugin.json"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
