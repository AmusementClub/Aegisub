{
  "version": 1,
  "name": "subtitle-grid-folding-background",
  "hosts": ["gui-test"],
  "load_global_scripts": false,
  "default_timeout_ms": 5000,
  "steps": [
    { "action": "command", "id": "am/reload/autoload" },
    { "action": "command", "id": "automation/lua/subtitle-grid-folding/Prepare" },
    { "action": "command", "id": "grid/fold/create" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Original collapsed", "field": "validated", "equals": true },
    { "action": "command", "id": "grid/fold/expand" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Original expanded", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Original collapsed", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/redo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Original expanded", "field": "validated", "equals": true },
    { "action": "command", "id": "grid/fold/collapse" },
    { "action": "command", "id": "automation/lua/subtitle-grid-folding/Replace boundary text" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Edited collapsed", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Original collapsed", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/redo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Edited collapsed", "field": "validated", "equals": true },
    { "action": "command", "id": "automation/lua/subtitle-grid-folding/Select original" },
    { "action": "command", "id": "edit/line/duplicate" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Full copy has fresh ID", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Edited collapsed", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/redo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Full copy has fresh ID", "field": "validated", "equals": true },
    { "action": "command", "id": "automation/lua/subtitle-grid-folding/Select end boundary" },
    { "action": "command", "id": "edit/line/duplicate" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Partial duplicate has no marker", "field": "validated", "equals": true },
    { "action": "command", "id": "grid/fold/clear/all" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/All markers cleared", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Partial duplicate has no marker", "field": "validated", "equals": true },
    { "action": "command", "id": "edit/undo" },
    { "action": "command", "id": "edit/undo" },
    { "action": "command", "id": "edit/undo" },
    { "action": "command", "id": "edit/undo" },
    { "action": "command", "id": "edit/undo" },
    { "action": "command", "id": "edit/undo" },
    { "action": "command", "id": "edit/undo" },
    { "action": "assert", "target": "command", "id": "automation/lua/subtitle-grid-folding/Initial default restored", "field": "validated", "equals": true },
    { "action": "assert", "target": "command", "id": "edit/undo", "field": "validated", "equals": false }
  ]
}
